local ConnectionManager = {}
ConnectionManager.__index = ConnectionManager
function ConnectionManager.new() return setmetatable({ Items = {} }, ConnectionManager) end
function ConnectionManager:Add(task) self.Items[#self.Items + 1] = task; return task end
function ConnectionManager:Cleanup()
	for i = #self.Items, 1, -1 do
		local item = self.Items[i]
		self.Items[i] = nil
		local t = typeof(item)
		if t == "RBXScriptConnection" then pcall(function() item:Disconnect() end)
		elseif t == "Instance" then pcall(function() item:Destroy() end)
		elseif t == "function" then pcall(item) end
	end
end

local KILLALL_INTERVAL = 0.15

local KillAll = {}
KillAll.__index = KillAll

function KillAll.new()
	return setmetatable({
		running = false,
		connections = ConnectionManager.new(),
		accumulator = 0,
	}, KillAll)
end

function KillAll:IsKnife(tool)
	if not (tool and tool:IsA("Tool")) then return false end
	if tool:FindFirstChild("fire") or tool:FindFirstChild("showBeam") then return false end
	return tool:FindFirstChild("Slash") ~= nil or tool:FindFirstChild("SlashStart") ~= nil or tool:FindFirstChild("Handle") ~= nil
end

function KillAll:FindKnife()
	local char = localPlayer.Character
	if char then
		for _, child in ipairs(char:GetChildren()) do
			if self:IsKnife(child) then return child, true end
		end
	end
	local backpack = localPlayer:FindFirstChildOfClass("Backpack")
	if backpack then
		for _, child in ipairs(backpack:GetChildren()) do
			if self:IsKnife(child) then return child, false end
		end
	end
	return nil, false
end

function KillAll:EnsureKnifeEquipped()
	local tool, equipped = self:FindKnife()
	if not tool then return nil end
	if not equipped then
		local hum = localPlayer.Character and localPlayer.Character:FindFirstChildOfClass("Humanoid")
		if hum then pcall(function() hum:EquipTool(tool) end) end
	end
	return tool
end

function KillAll:HitTarget(tool, char)
	if not tool or not char then return end
	local handle = tool:FindFirstChild("Handle")
	if not handle then return end

	local parts = {
		char:FindFirstChild("HumanoidRootPart"),
		char:FindFirstChild("Head"),
		char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso"),
		char:FindFirstChild("LowerTorso"),
	}

	if firetouchinterest then
		for _, part in ipairs(parts) do
			if part then
				pcall(function()
					firetouchinterest(handle, part, 0)
					firetouchinterest(handle, part, 1)
				end)
			end
		end
	end

	if elremotelistope then
		pcall(function()
			elremotelistope:FireServer(PRIMERARG1)
		end)
	end

	pcall(function()
		tool:Activate()
	end)
end

function KillAll:Update(dt)
	if not IsInMatchStrict() then return end

	self.accumulator = self.accumulator + (dt or 0)
	if self.accumulator < KILLALL_INTERVAL then return end
	self.accumulator = 0

	local tool = self:EnsureKnifeEquipped()
	if not tool then return end

	for _, other in ipairs(Players:GetPlayers()) do
		if esEnemigoValido(other) then
			local char = other.Character
			if char then
				self:HitTarget(tool, char)
			end
		end
	end
end

function KillAll:Start()
	if self.running then return end
	self.running = true
	KillAllEnabled = true
	self.accumulator = 0
	self.connections:Add(RunService.Heartbeat:Connect(function(dt)
		if self.running then self:Update(dt) end
	end))
end

function KillAll:Stop()
	self.running = false
	KillAllEnabled = false
	self.connections:Cleanup()
	self.connections = ConnectionManager.new()
	self.accumulator = 0
end

local KillAllInstance = KillAll.new()

local function setKillAllEnabled(value)
	KillAllEnabled = value == true
	if KillAllEnabled then
		KillAllInstance:Start()
	else
		KillAllInstance:Stop()
	end
end

