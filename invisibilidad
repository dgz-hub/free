local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local PhysicsService = game:GetService("PhysicsService")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local isInvisible = false
local character, humanoid, rootPart
local characterParts = {}
local invisibleHeartbeatConnection = nil
local invisibleWalkSpeed = 16

local GROUP_INVISIBLE = "InvisiblePlayer"
local GROUP_OTHERS    = "OtherPlayers"
local collisionGroupsReady = false

local INVISIBLE_ALTITUDE = 4000

local invisibleVisualClone           = nil
local invisibleVisualRoot            = nil
local invisibleOriginalPosition      = nil
local invisibleOriginalAutoRotate    = nil
local invisibleOriginalPlatformStand = nil
local invisibleOriginalJumpHeight    = nil
local invisibleOriginalJumpPower     = nil
local invisibleFallVelocity          = 0
local invisibleLastGroundCheck       = os.clock()
local invisibleGroundOffset          = nil
local invisibleEnabled               = false

local LANDING_LERP_SPEED = 6

local function setupCollisionGroups()
    if collisionGroupsReady then return end
    pcall(function() PhysicsService:RegisterCollisionGroup(GROUP_INVISIBLE) end)
    pcall(function() PhysicsService:RegisterCollisionGroup(GROUP_OTHERS) end)
    pcall(function()
        PhysicsService:CollisionGroupSetCollidable(GROUP_INVISIBLE, GROUP_OTHERS, false)
    end)
    collisionGroupsReady = true
end

local function assignGroupToCharacter(char, groupName)
    if not char then return end
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") then
            pcall(function() PhysicsService:SetPartCollisionGroup(part, groupName) end)
        end
    end
    char.DescendantAdded:Connect(function(obj)
        if obj:IsA("BasePart") then
            pcall(function() PhysicsService:SetPartCollisionGroup(obj, groupName) end)
        end
    end)
end

local function resetGroupOnCharacter(char)
    if not char then return end
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") then
            pcall(function() PhysicsService:SetPartCollisionGroup(part, "Default") end)
        end
    end
end

local function tagOtherPlayers()
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player and p.Character then
            assignGroupToCharacter(p.Character, GROUP_OTHERS)
        end
        p.CharacterAdded:Connect(function(char)
            if p ~= player then
                task.wait(0.1)
                assignGroupToCharacter(char, GROUP_OTHERS)
            end
        end)
    end
end

Players.PlayerAdded:Connect(function(p)
    if p == player then return end
    p.CharacterAdded:Connect(function(char)
        task.wait(0.1)
        assignGroupToCharacter(char, GROUP_OTHERS)
    end)
end)

