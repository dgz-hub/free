local function refreshPowerButton()
    if state.enabled then
        powerBtn.Text = "Plataforma: ON"
        powerBtn.BackgroundColor3 = Color3.fromRGB(45, 145, 65)
        powerBtn.TextColor3 = COLORS.On
    else
        powerBtn.Text = "Plataforma: OFF"
        powerBtn.BackgroundColor3 = COLORS.Red
        powerBtn.TextColor3 = COLORS.On
    end
end

powerBtn.Activated:Connect(function()
    state.enabled = not state.enabled
    refreshPowerButton()
    if not state.enabled then
        state.descendToken += 1
        removePlatform()
    end
end)

