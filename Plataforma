}

local function getCharacterParts()
    local character = LocalPlayer.Character
    if not character or not character.Parent then
        return nil, nil, nil
    end

    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local root = character:FindFirstChild("HumanoidRootPart")

    if not humanoid or humanoid.Health <= 0 or not root or not root:IsA("BasePart") then
        return character, nil, nil
    end

    return character, humanoid, root
end

local function restoreJump(humanoid)
    if not humanoid then return end
    if humanoid:GetAttribute("PlatformOriginalUseJumpPower") ~= nil then
        humanoid.UseJumpPower = humanoid:GetAttribute("PlatformOriginalUseJumpPower")
        humanoid:SetAttribute("PlatformOriginalUseJumpPower", nil)
    end
    if humanoid:GetAttribute("PlatformOriginalJumpPower") ~= nil then
        humanoid.JumpPower = humanoid:GetAttribute("PlatformOriginalJumpPower")
        humanoid:SetAttribute("PlatformOriginalJumpPower", nil)
    end
    if humanoid:GetAttribute("PlatformOriginalJumpHeight") ~= nil then
        humanoid.JumpHeight = humanoid:GetAttribute("PlatformOriginalJumpHeight")
        humanoid:SetAttribute("PlatformOriginalJumpHeight", nil)
    end
end

local function removePlatform()
    if state.platform then
        state.platform:Destroy()
        state.platform = nil
    end

    local oldCharacter = state.character
    state.character = nil

    local character = oldCharacter or LocalPlayer.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    restoreJump(humanoid)

    local root = character and character:FindFirstChild("HumanoidRootPart")
    if root and root:IsA("BasePart") and root:GetAttribute("PlatformWasAnchored") ~= nil then
        root.Anchored = root:GetAttribute("PlatformWasAnchored")
        root:SetAttribute("PlatformWasAnchored", nil)
    end
end

local function createPlatform(character)
    if state.platform then
        state.platform:Destroy()
    end

    local platform = Instance.new("Part")
    platform.Name = "RidePlatform_Client"
    platform.Size = PLATFORM_SIZE
    platform.Transparency = 0.3
    platform.Color = Color3.fromRGB(70, 70, 80)
    platform.Material = Enum.Material.SmoothPlastic
    platform.CastShadow = false
    platform.Anchored = true
    platform.CanCollide = true
    platform.CanTouch = false
    platform.CanQuery = false
    platform.TopSurface = Enum.SurfaceType.Smooth
    platform.BottomSurface = Enum.SurfaceType.Smooth
    platform.Parent = workspace

    state.platform = platform
    state.character = character
end

local function stepHeight(direction)
    if not state.enabled then return end

    local now = os.clock()
    if now - state.lastStepAt < STEP_COOLDOWN then return end
    state.lastStepAt = now

    local character, humanoid, root = getCharacterParts()
    if not character or not humanoid or not root then return end

    if direction < 0 then
        -- Anclar brevemente durante el descenso para evitar que la física
        -- empuje al personaje mientras atraviesa la geometría.
        state.descendToken += 1
        local token = state.descendToken

        if root:GetAttribute("PlatformWasAnchored") == nil then
            root:SetAttribute("PlatformWasAnchored", root.Anchored)
        end
        root.Anchored = true
        root.CFrame = root.CFrame + Vector3.new(0, -HEIGHT_STEP, 0)
        root.AssemblyLinearVelocity = Vector3.zero

        task.delay(DESCEND_ANCHOR_TIME, function()
            if token ~= state.descendToken then return end
            if root and root.Parent and root:GetAttribute("PlatformWasAnchored") ~= nil then
                root.Anchored = root:GetAttribute("PlatformWasAnchored")
                root:SetAttribute("PlatformWasAnchored", nil)
            end
        end)
    else
        -- Si se pulsa subir mientras el descenso sigue anclado, cancelar
        -- la liberación pendiente y restaurar el estado normal antes de subir.
        state.descendToken += 1
        if root:GetAttribute("PlatformWasAnchored") ~= nil then
            root.Anchored = root:GetAttribute("PlatformWasAnchored")
            root:SetAttribute("PlatformWasAnchored", nil)
        end

        root.CFrame = root.CFrame + Vector3.new(0, HEIGHT_STEP, 0)
        local velocity = root.AssemblyLinearVelocity
        root.AssemblyLinearVelocity = Vector3.new(velocity.X, 0, velocity.Z)
    end
end

local function getGuiParent()
    local ok, hui = pcall(function()
        return gethui and gethui()
    end)
    if ok and hui then return hui end

    local okCore, protected = pcall(function()
        if syn and syn.protect_gui then
            local gui = Instance.new("ScreenGui")
            syn.protect_gui(gui)
            return CoreGui
        end
        return CoreGui
    end)
    return (okCore and protected) or LocalPlayer:WaitForChild("PlayerGui")
end

