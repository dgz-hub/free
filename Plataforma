    state.enabled = false
    state.descendToken += 1
    removePlatform()
    ScreenGui:Destroy()
end)

-- Arrastrar desde cualquier zona vacía del panel (incluidos los bordes).
-- Los botones siguen funcionando normalmente al pulsarlos.
local dragging = false
local dragStart
local startPos
local dragInput

local function pointInside(guiObject, point)
    local pos = guiObject.AbsolutePosition
    local size = guiObject.AbsoluteSize
    return point.X >= pos.X and point.X <= pos.X + size.X
        and point.Y >= pos.Y and point.Y <= pos.Y + size.Y
end

local function beginDrag(input)
    if input.UserInputType ~= Enum.UserInputType.MouseButton1
        and input.UserInputType ~= Enum.UserInputType.Touch then
        return
    end

    -- No iniciar arrastre al pulsar uno de los botones.
    local point = input.Position
    if pointInside(powerBtn, point) or pointInside(downBtn, point)
        or pointInside(upBtn, point) or pointInside(closeBtn, point) then
        return
    end

    dragging = true
    dragStart = point
    startPos = Frame.Position
    dragInput = input
end

Frame.InputBegan:Connect(beginDrag)
topBar.InputBegan:Connect(beginDrag)

UserInputService.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dragStart
        Frame.Position = UDim2.new(
            startPos.X.Scale, startPos.X.Offset + delta.X,
            startPos.Y.Scale, startPos.Y.Offset + delta.Y
        )
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
        dragging = false
        dragInput = nil
    end
end)

local heartbeatConnection
heartbeatConnection = RunService.Heartbeat:Connect(function()
    if not ScreenGui.Parent then
        if heartbeatConnection then heartbeatConnection:Disconnect() end
        return
    end

    local character, humanoid, root = getCharacterParts()

    if not state.enabled then
        if state.platform then removePlatform() end
        return
    end

    if not humanoid or not root then
        if state.platform then removePlatform() end
        return
    end

    if humanoid:GetAttribute("PlatformOriginalUseJumpPower") == nil then
        humanoid:SetAttribute("PlatformOriginalUseJumpPower", humanoid.UseJumpPower)
        humanoid:SetAttribute("PlatformOriginalJumpPower", humanoid.JumpPower)
        humanoid:SetAttribute("PlatformOriginalJumpHeight", humanoid.JumpHeight)
    end

    humanoid.UseJumpPower = true
    humanoid.JumpPower = 0
    humanoid.JumpHeight = 0

    if state.character ~= character or not state.platform or not state.platform.Parent then
        createPlatform(character)
    end

    local platform = state.platform
    if platform then
        local footOffset = humanoid.HipHeight + (root.Size.Y * 0.5) + (platform.Size.Y * 0.5)
        platform.CFrame = CFrame.new(
            root.Position.X,
            root.Position.Y - footOffset,
            root.Position.Z
        )
    end
end)

