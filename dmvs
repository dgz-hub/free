local function silentPartVisible(fromPos, part, myChar, enemyChar, params)
    if not part then return false end
    params.FilterDescendantsInstances = { myChar, enemyChar }
    local hit = workspace:Raycast(fromPos, part.Position - fromPos, params)
    if not hit then return true end
    return hit.Instance and hit.Instance:IsDescendantOf(enemyChar)
end

local function findSilentTarget(useFov)
    local char = player.Character
    if not char then return nil end
    local myRoot = char:FindFirstChild("HumanoidRootPart")
    local myHead = char:FindFirstChild("Head")
    if not myRoot then return nil end
    local cam = workspace.CurrentCamera
    if not cam then return nil end
    local fromPos = myHead and myHead.Position or myRoot.Position
    local screenCenter = Vector2.new(cam.ViewportSize.X * 0.5, cam.ViewportSize.Y * 0.5)
    local mousePos = UserInputService:GetMouseLocation()
    local aimPoint = useFov and screenCenter or mousePos
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    local bestPart, bestScore = nil, math.huge
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player and esEnemigoValido(p) then
            local eChar = p.Character
            if eChar then
                local parts = silentGetAimParts(eChar)
                for i = 1, #parts do
                    local part = parts[i]
                    local pos2d, onScreen = cam:WorldToViewportPoint(part.Position)
                    if onScreen and pos2d.Z > 0 then
                        local screenDist = (aimPoint - Vector2.new(pos2d.X, pos2d.Y)).Magnitude
                        if (not useFov) or (screenDist <= silentAimFovSize) then
                            if silentPartVisible(fromPos, part, char, eChar, params) then
                                local worldDist = (part.Position - fromPos).Magnitude
                                local score = screenDist + worldDist * 0.02
                                if score < bestScore then bestScore = score; bestPart = part end
                            end
                        end
                    end
                end
            end
        end
    end
    return bestPart
end

