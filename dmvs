local camlockRayParams = RaycastParams.new()
camlockRayParams.FilterType = Enum.RaycastFilterType.Exclude

local function getCamlockAimPart(char)
    if not char then return nil end
    return char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso") or char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Head")
end

local function camlockVisible(from, part, myChar)
    if not part or not part.Parent then return false end
    local enemyChar = part.Parent
    camlockRayParams.FilterDescendantsInstances = { myChar, enemyChar }
    local dir = part.Position - from
    local hit = workspace:Raycast(from, dir, camlockRayParams)
    if not hit then return true end
    return hit.Instance and hit.Instance:IsDescendantOf(enemyChar)
end

local function FindNearestEnemyCamlock()
    local myChar = player.Character
    if not myChar then return nil end
    local myHead = myChar:FindFirstChild("Head") or myChar:FindFirstChild("HumanoidRootPart")
    if not myHead then return nil end
    local cam = workspace.CurrentCamera
    if not cam then return nil end
    local screenCenter = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2)
    local origin = myHead.Position
    local bestPart, bestScore = nil, math.huge
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player and esEnemigoValido(p) then
            local char = p.Character
            if char then
                local aimPart = getCamlockAimPart(char)
                if aimPart and aimPart:IsA("BasePart") then
                    local dist3d = (aimPart.Position - origin).Magnitude
                    if dist3d <= CAMLOCK_MAX_DIST then
                        local pos2d, onScreen = cam:WorldToViewportPoint(aimPart.Position)
                        if onScreen and pos2d.Z > 0 then
                            local screenDist = (screenCenter - Vector2.new(pos2d.X, pos2d.Y)).Magnitude
                            if screenDist <= CAMLOCK_FOV_PX then
                                if camlockVisible(origin, aimPart, myChar) then
                                    local score = screenDist + dist3d * 0.05
                                    if score < bestScore then bestScore = score; bestPart = aimPart end
                                end
                            end
                        end
                    end
                end
            end
        end
    end
    return bestPart
end

