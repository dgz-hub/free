    if tool:FindFirstChild("Throw", true) or tool:FindFirstChild("KnifeClient", true) or tool:FindFirstChild("KnifeServer", true) then return false end
    local name = string.lower(tool.Name)
    for _, word in ipairs({"combat","fist","wallet","phone","punch","boombox","radio","blade","kunai","sword","toy","juguete","pizza","burger","teddy","balloon","drink","food"}) do
