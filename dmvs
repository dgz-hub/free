getgenv().ClanxitadosTargetPart = nil

local SILENT_BULLET_SPEED = 99999  
local SILENT_MAX_LEAD_VEL = 0       
local SILENT_MIN_DIR = 5            

local function predictSilentAimPosition(origin, target)
    if not target or not target.Parent then return origin end
    local pos = target.Position
    local vel = target.AssemblyLinearVelocity
    local speed = vel.Magnitude
    if speed > SILENT_MAX_LEAD_VEL then
        vel = vel.Unit * SILENT_MAX_LEAD_VEL
    elseif speed < 1.25 then
        return pos
    end
    local distance = (pos - origin).Magnitude
    local travelTime = distance / SILENT_BULLET_SPEED
    return pos + vel * travelTime
end

local function silentGetAimParts(character)
    local parts = {}
    if not character then return parts end
    if silentAimTargetPart == "Cabeza" then
        local head = character:FindFirstChild("Head")
        if head and head:IsA("BasePart") then parts[1] = head end
    elseif silentAimTargetPart == "Torso" then
        for _, name in ipairs({ "UpperTorso", "Torso", "HumanoidRootPart" }) do
            local p = character:FindFirstChild(name)
            if p and p:IsA("BasePart") then parts[#parts + 1] = p end
        end
    else
        for _, p in ipairs(character:GetChildren()) do
