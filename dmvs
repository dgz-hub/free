    local timer = score and score:FindFirstChild("Timer")
    if not timer then return false end
    local value = tostring(timer.Text or ""):gsub("%s", "")
    if value == "" or value:find("-", 1, true) or value == "0:00" or value == "00:00" then return false end
    return value:match("^%d+:%d%d$") ~= nil
