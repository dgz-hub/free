local triggerRayParams = RaycastParams.new()
triggerRayParams.FilterType = Enum.RaycastFilterType.Exclude

local function triggerTargetClearlyVisible(character)
    local cam = workspace.CurrentCamera
    local myCharacter = player.Character
    if not cam or not character or not myCharacter then return false end
    local samples = {
        character:FindFirstChild("Head"),
        character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso"),
        character:FindFirstChild("HumanoidRootPart")
    }
    triggerRayParams.FilterDescendantsInstances = {myCharacter, character}
    local visiblePoints = 0
    for _, part in ipairs(samples) do
        if part and part:IsA("BasePart") then
            local screenPos, onScreen = cam:WorldToViewportPoint(part.Position)
            if onScreen and screenPos.Z > 0 then
                local origin = cam.CFrame.Position
                local direction = part.Position - origin
                local obstruction = workspace:Raycast(origin, direction, triggerRayParams)
                if not obstruction then
                    visiblePoints += 1
                    if visiblePoints >= TRIGGER_MIN_VISIBLE_POINTS then return true end
                end
            end
        end
    end
    return false
end

