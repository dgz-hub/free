local camlockLastFrame = os.clock()
RunService.RenderStepped:Connect(function()
    local now = os.clock()
    local dt = math.clamp(now - camlockLastFrame, 0, 1 / 20)
    camlockLastFrame = now
    if not camlockPuedeActivar() then camlockTarget = nil; return end
    local cam = workspace.CurrentCamera
    local myChar = player.Character
    local myHead = myChar and (myChar:FindFirstChild("Head") or myChar:FindFirstChild("HumanoidRootPart"))
    if not cam or not myHead then camlockTarget = nil; return end
    local needNew = not (camlockTarget and camlockTarget.Parent)
    if not needNew then
        local enemyChar = camlockTarget:FindFirstAncestorOfClass("Model")
        local targetPlayer = enemyChar and Players:GetPlayerFromCharacter(enemyChar)
        local screenPos, onScreen = cam:WorldToViewportPoint(camlockTarget.Position)
        if not targetPlayer or not esEnemigoValido(targetPlayer) or not onScreen or screenPos.Z <= 0 or (camlockTarget.Position - myHead.Position).Magnitude > CAMLOCK_MAX_DIST or not camlockVisible(myHead.Position, camlockTarget, myChar) then
            needNew = true
        end
    end
    if needNew then camlockTarget = FindNearestEnemyCamlock(); lastRetargetTime = now end
    if camlockTarget and camlockTarget.Parent then
        local velocity = camlockTarget.AssemblyLinearVelocity
        if velocity.Magnitude > 120 then velocity = velocity.Unit * 120 end
        local predictPos = camlockTarget.Position + velocity * CAMLOCK_PREDICTION
        local currentCF = cam.CFrame
        local targetCF = CFrame.lookAt(currentCF.Position, predictPos)
        local alpha = 1 - math.exp(-CAMLOCK_LERP * 60 * dt)
        cam.CFrame = currentCF:Lerp(targetCF, math.clamp(alpha, 0, 0.35))
    end
end)

