local telaMovementEnabled = false
local telaMovementName = "FreeFireTelaMovement"
local telaMovementSettings = { TurnSpeed = 45, SideThreshold = 0.35, InstantTurn = false }

local function stopTelaMovement()
    RunService:UnbindFromRenderStep(telaMovementName)
    local character = player.Character; local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    if humanoid then humanoid.AutoRotate = true end
end

local function startTelaMovement()
    RunService:UnbindFromRenderStep(telaMovementName)
    RunService:BindToRenderStep(telaMovementName, Enum.RenderPriority.Character.Value + 1, function(dt)
        if not telaMovementEnabled then return end
        local character = player.Character; if not character then return end
        local humanoid = character:FindFirstChildOfClass("Humanoid"); local root = character:FindFirstChild("HumanoidRootPart"); local cam = workspace.CurrentCamera
        if not humanoid or not root or not cam or humanoid.Health <= 0 then return end
        local rightVector = cam.CFrame.RightVector; local right = Vector3.new(rightVector.X, 0, rightVector.Z)
        if right.Magnitude < 0.001 then return end; right = right.Unit
        local side = humanoid.MoveDirection:Dot(right)
        if math.abs(side) < telaMovementSettings.SideThreshold then humanoid.AutoRotate = true; return end
        humanoid.AutoRotate = false; local pos = root.Position
        local target = CFrame.lookAt(pos, pos + (side > 0 and right or -right))
        root.CFrame = telaMovementSettings.InstantTurn and target or root.CFrame:Lerp(target, 1 - math.exp(-telaMovementSettings.TurnSpeed * dt))
    end)
end

UIElements.TogMovimientoTela = Tabs.Player:Toggle({ Title = "Movimiento Tela", Value = false, Callback = function(enabled) telaMovementEnabled = enabled == true; if telaMovementEnabled then startTelaMovement() else stopTelaMovement() end end })
