task.spawn(function()
    while task.wait(0.2) do
        local anyEnemyEsp = espEnabled or espLineEnabled or espNameEnabled
        local anyAllyEsp = espAllyEnabled or espAllyLineEnabled or espAllyNameEnabled
        if (anyEnemyEsp or anyAllyEsp) and IsInMatchStrict() then
            local myChar = player.Character; local myHead = myChar and myChar:FindFirstChild("Head"); local myPos = myHead and myHead.Position
            for _, p in pairs(Players:GetPlayers()) do
                if p ~= player then
                    local char = p.Character; local serverConfirmedDead = char and serverDeadCharacters[char] == true
                    local enemy = isEnemy(p); local ally = isAlly(p); local useEnemy = enemy and anyEnemyEsp; local useAlly = ally and anyAllyEsp
                    if char and not serverConfirmedDead and char:FindFirstChild("Head") and (useEnemy or useAlly) then
                        local targetHead = char.Head; local dist = myPos and (targetHead.Position - myPos).Magnitude or 0
                        if dist <= MAX_ESP_DISTANCE then
                            local wantAlly = useAlly and not useEnemy
                            if activeESPs[p] and (activeESPs[p].Char ~= char or activeESPs[p].IsAlly ~= wantAlly) then cleanESP(p) end
                            if not activeESPs[p] then activeESPs[p] = { Char = char, IsAlly = wantAlly } end
                            local espObj = activeESPs[p]
                            local hlOn = wantAlly and espAllyEnabled or (not wantAlly and espEnabled)
                            local lineOn = wantAlly and espAllyLineEnabled or (not wantAlly and espLineEnabled)
                            local nameOn = wantAlly and espAllyNameEnabled or (not wantAlly and espNameEnabled)
                            local hlColor = wantAlly and espAllyColor or espColor
                            local lineColor = wantAlly and espAllyLineColor or espLineColor
                            local nameColor = wantAlly and espAllyNameColor or espNameColor
                            if hlOn then
                                if not espObj.Highlight then
                                    local highlight = Instance.new("Highlight"); highlight.Name = p.Name .. "_Glow"; highlight.FillTransparency = 1; highlight.OutlineTransparency = 0
                                    highlight.Enabled = true; highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop; highlight.Adornee = char; highlight.Parent = espFolder; espObj.Highlight = highlight
                                end
                                if espObj.Highlight.OutlineColor ~= hlColor then espObj.Highlight.OutlineColor = hlColor end
                            elseif espObj.Highlight then pcall(function() espObj.Highlight:Destroy() end); espObj.Highlight = nil end
                            if lineOn then if not espObj.Line then local gui, line = createLineESP(p); espObj.LineGui = gui; espObj.Line = line end; espObj.Line.BackgroundColor3 = lineColor
                            elseif espObj.Line then pcall(function() espObj.LineGui:Destroy() end); espObj.Line = nil; espObj.LineGui = nil end
                            if nameOn then if not espObj.NameLabel then local gui, label = createNameESP(p); espObj.NameGui = gui; espObj.NameLabel = label end; espObj.NameLabel.TextColor3 = nameColor
